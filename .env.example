# Copia este archivo a ".env" y pon tus claves reales.
# El archivo .env NO debe subirse nunca a un repositorio publico.

# Obligatoria para Google Safe Browsing (recomendada):
GOOGLE_SAFE_BROWSING_KEY=pon_aqui_tu_clave

# Recomendada — desde 2025 abuse.ch exige autenticación en sus APIs.
# Sin esta clave, URLhaus y ThreatFox NO se consultan.
# Se obtiene gratis en https://auth.abuse.ch/
ABUSECH_AUTH_KEY=pon_aqui_tu_clave_de_abusech

# Opcional — amplía la cobertura con VirusTotal (90+ motores):
VIRUSTOTAL_API_KEY=pon_aqui_tu_clave_opcional

# Opcional — restringe el CORS a tu dominio exacto (en producción).
# Si no se define, la función acepta peticiones desde cualquier origen.
ALLOWED_ORIGIN=https://tu-sitio.netlify.app
